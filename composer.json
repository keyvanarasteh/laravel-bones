{
    "name": "keyvanarasteh/laravel-bones",
    "description": "An X-ray for your Laravel application: explore its routes, view nodes and package skeleton in one clean dashboard.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "devtools",
        "routes",
        "views",
        "packages",
        "skeleton",
        "visualizer",
        "debug"
    ],
    "authors": [
        {
            "name": "Keyvan Arasteh",
            "email": "keyvan.arasteh@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Keyvanarasteh\\LaravelBones\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keyvanarasteh\\LaravelBones\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Keyvanarasteh\\LaravelBones\\BonesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
